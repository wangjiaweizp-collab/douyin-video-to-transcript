# 统一换行符，避免 Windows / macOS / Linux 之间产生无意义 diff
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.txt  text eol=lf

# 二进制资产（本仓库当前没有，但防止将来误判）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.wav  binary
*.zip  binary
